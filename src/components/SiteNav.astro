---
import { studio } from "../config"
import { navLinks } from "../lib/categories"
import { pagePath } from "../lib/paths"
import Logo from "./Logo.astro"

/**
 * The chrome that stays put on every page, laid out from the Figma design:
 * the wordmark turned on its side down the left margin, the menu in a row
 * along the top, and where the studio works at the foot of the left margin.
 * On the phone the whole thing collapses into a stacked header.
 */

/** Current path in the same form the menu links are written in. */
const here = pagePath(Astro.url)
const isCurrent = (href: string) => here === href

const where = studio.regions.join(" e ")
---

<header class="chrome">
  <a
    class="brand"
    href="/"
    aria-label="ORMA Arquitetura, ir para a página inicial"
  >
    <Logo />
  </a>

  <nav class="menu" aria-label="Navegação principal">
    <ul role="list">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={isCurrent(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <p class="where">
    {where}
    <span>{studio.country}</span>
  </p>
</header>

<style>
  /* --- phone: one stacked header, the wordmark the right way up --- */
  .chrome {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-block-size: var(--header-flow);
    padding: var(--space-3) var(--edge);
    background: var(--color-paper);
  }

  .brand {
    --logo-width: clamp(6rem, 26vw, 9rem);
    display: block;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    /* Narrow enough that the phone splits it the way it reads: the three kinds
       of work on one line, the two other pages on the next. */
    max-inline-size: 17rem;
    gap: 0.35rem clamp(0.9rem, 4.2vw, 5rem);
    margin: 0;
    padding: 0;
  }

  li a {
    display: block;
    padding-block: 0.35rem;
    font-size: var(--text-ui);
    line-height: 1.2;
    color: var(--color-ink);
  }

  /* The line under the current page, drawn in on hover for the others. */
  li a::after {
    content: "";
    display: block;
    block-size: 1px;
    margin-block-start: 0.25em;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--motion-fast) var(--ease-out-soft);
  }

  li a[aria-current="page"]::after,
  li a:hover::after,
  li a:focus-visible::after {
    transform: scaleX(1);
  }

  /* Hidden on the phone: the footer already says where the studio works. */
  .where {
    display: none;
    font-size: var(--text-ui);
    line-height: 1.35;
    text-align: center;
  }

  .where span {
    display: block;
    margin-block-start: 1.35em;
  }

  /* --- desktop: the Figma layout, fixed while the photographs scroll --- */
  @media (min-width: 60rem) {
    /* One fixed layer over the page; only the pieces themselves take clicks. */
    .chrome {
      position: fixed;
      inset: 0;
      z-index: 20;
      display: block;
      padding: 0;
      background: none;
      pointer-events: none;
    }

    .chrome > * {
      pointer-events: auto;
    }

    /* The page is two columns: the rail on the left that stays put, holding the
       sideways wordmark, and the column on the right that scrolls, carrying the
       photographs and everything written. The white band still runs the full
       width, so photographs disappear behind it rather than into the margin,
       but the words inside it are centred on the right-hand column alone — the
       rail is padded out of the reckoning, so the middle of the menu and the
       middle of the photographs are the same pixel at every width. */
    .menu {
      position: absolute;
      inset-block-start: 0;
      inset-inline: 0;
      display: grid;
      place-items: center;
      block-size: var(--header-height);
      padding-block-start: var(--edge);
      padding-inline: var(--rail-width) var(--edge);
      background: var(--color-paper);
    }

    /* The words spread across the shared measure rather than setting their own
       width, so the first and last of them sit exactly above the ends of every
       line of text on the page below. */
    ul {
      flex-wrap: nowrap;
      inline-size: var(--measure);
      max-inline-size: none;
      justify-content: space-between;
      gap: 0;
    }

    /* The wordmark on its side, reading upwards, top-aligned with the photos. */
    .brand {
      --logo-length: clamp(9rem, 32.8vh, 21rem);
      --logo-thickness: calc(var(--logo-length) * 0.2073);
      position: absolute;
      inset-block-start: var(--header-height);
      inset-inline-start: calc((var(--rail-width) - var(--logo-thickness)) / 2);
      inline-size: var(--logo-thickness);
      block-size: var(--logo-length);
    }

    .brand :global(.logo) {
      position: absolute;
      inset: 0 auto auto 0;
      inline-size: var(--logo-length);
      /* The rotated wordmark is longer than the box it stands in. */
      max-inline-size: none;
      transform-origin: 0 0;
      transform: rotate(-90deg) translateX(-100%);
    }

    .where {
      position: absolute;
      inset-block-end: var(--edge);
      inset-inline-start: 0;
      display: block;
      inline-size: var(--rail-width);
      padding-inline: var(--space-2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    li a::after {
      transition: none;
    }
  }
</style>
