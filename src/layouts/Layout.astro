---
import Footer from "../components/Footer.astro"
import PostHog from "../components/posthog.astro"
import { getImage } from "astro:assets"
import { ClientRouter } from "astro:transitions"
import SiteNav from "../components/SiteNav.astro"
import { studio } from "../config"
import { PHOTO } from "../lib/images"
import { pagePath } from "../lib/paths"
import {
  absolute,
  LANGUAGE,
  LOGO,
  SOCIAL_CARD,
  studioSchema,
  TITLE,
  websiteSchema,
} from "../seo"
import type { ImageMetadata } from "astro"
import "../styles/global.css"

interface Props {
  /** Page name; the studio name is appended automatically. */
  title?: string
  description: string
  /**
   * The photograph this page opens on, when it has one above the fold. It is
   * announced in the <head> so the browser starts fetching it as the page
   * arrives, instead of waiting until it has parsed and styled its way down to
   * the picture itself — on a portfolio that is the difference between the
   * first screen appearing and the first screen appearing a beat later.
   */
  openingPhoto?: { src: ImageMetadata; sizes: string }
  /**
   * The photograph this page is represented by when its link is pasted into
   * WhatsApp or Instagram. Defaults to the one the page opens on, and to the
   * studio's own card for the pages that open on words.
   */
  socialPhoto?: { src: ImageMetadata; alt: string }
  /**
   * What this page *is*, as structured data: a collection of projects, one
   * project, the studio, a way to get in touch. Joined to the site-wide nodes
   * below, so every page ships one connected graph rather than loose facts.
   */
  schema?: Record<string, unknown>[]
  /**
   * Keep this page out of search results. For the pages that exist to catch a
   * visitor rather than to be found: a wrong address is not a page anyone
   * should arrive at from a search. Links are still followed, so the way back
   * into the site is not a dead end for a crawler either.
   */
  noindex?: boolean
}

const {
  title,
  description,
  openingPhoto,
  socialPhoto,
  schema = [],
  noindex = false,
} = Astro.props

const pageTitle = title ? TITLE.pattern(title) : TITLE.home
const canonical = absolute(pagePath(Astro.url))

/**
 * Asking for the same widths and format the picture itself asks for, so the
 * browser is handed the identical set of files and picks the identical one —
 * a preload that doesn't match is a whole photograph downloaded twice.
 *
 * Only the modern format is announced. Browsers that can't read it skip a
 * preload carrying a `type` they don't support and simply find the fallback
 * the ordinary way, which is what they did before.
 */
const preload = openingPhoto
  ? await getImage({
      src: openingPhoto.src,
      widths: PHOTO.widths,
      format: PHOTO.formats[0],
    })
  : undefined

/**
 * The preview card. Cropped to the shape every platform expects and encoded as
 * JPEG on purpose: the scrapers behind WhatsApp and Facebook are not browsers
 * and several still do not read the modern formats the site serves visitors.
 */
const card = socialPhoto ??
  (openingPhoto && { src: openingPhoto.src, alt: description }) ?? {
    src: SOCIAL_CARD.fallback,
    alt: SOCIAL_CARD.fallbackAlt,
  }

const cardImage = await getImage({
  src: card.src,
  width: SOCIAL_CARD.width,
  height: SOCIAL_CARD.height,
  fit: "cover",
  format: "jpeg",
})

/** Square, raster and served from this domain, as the rich-result guidelines ask. */
const logo = await getImage({
  src: LOGO.src,
  width: LOGO.size,
  height: LOGO.size,
  format: "png",
})

/** One graph per page: who the studio is, what the site is, what this page is. */
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    studioSchema({
      logo: absolute(logo.src),
      image: absolute(cardImage.src),
    }),
    websiteSchema(),
    ...schema,
  ],
}
---

<!doctype html>
<html lang={LANGUAGE.tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />
    <meta name="theme-color" content="#f7f6f4" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    {preload && (
      <link
        rel="preload"
        as="image"
        type={`image/${PHOTO.formats[0]}`}
        imagesrcset={preload.srcSet.attribute}
        imagesizes={openingPhoto!.sizes}
        fetchpriority="high"
      />
    )}
    {/* A page kept out of search has no address worth declaring official: the
        404 would otherwise name /404, a URL that does not exist. */}
    {!noindex && <link rel="canonical" href={canonical} />}

    {/* Spelled out rather than left to a default, and with the extra
        directives that let a search page show the full description and a large
        photograph. */}
    <meta
      name="robots"
      content={
        noindex
          ? "noindex, follow"
          : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
      }
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={studio.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={LANGUAGE.open_graph} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute(cardImage.src)} />
    <meta property="og:image:type" content={SOCIAL_CARD.type} />
    <meta property="og:image:width" content={String(SOCIAL_CARD.width)} />
    <meta property="og:image:height" content={String(SOCIAL_CARD.height)} />
    <meta property="og:image:alt" content={card.alt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absolute(cardImage.src)} />
    <meta name="twitter:image:alt" content={card.alt} />

    {/* What this page is, in the form a search engine or an assistant reads
        rather than infers. One connected graph per page: the studio, the site,
        and whatever the page itself adds. */}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    ></script>
    <PostHog />

    {/* Lets a project photograph fly from the grid into its own page. */}
    <ClientRouter />
  </head>

  <body>
    <SiteNav />

    <main id="conteudo">
      <slot />
    </main>

    <Footer />

    <script src="../scripts/motion.js"></script>
  </body>
</html>

<style>
  /* The right-hand column, and the only one there is: every page sits to the
     right of the rail with the sideways logo, starts under the menu band, and
     runs to the same thin margin on the other side. One structure for all of
     them, so the menu above is centred on every page alike; a page that wants
     a narrower measure centres its own text inside this column rather than
     moving the column. */
  @media (min-width: 60rem) {
    main {
      margin-inline-start: var(--rail-width);
      padding-block-start: var(--header-height);
      padding-inline-end: var(--edge);
    }
  }
</style>
