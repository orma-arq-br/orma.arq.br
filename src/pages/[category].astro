---
import { getCollection } from "astro:content"
import type { GetStaticPaths } from "astro"

import ProjectGrid from "../components/ProjectGrid.astro"
import { studio } from "../config"
import { categories } from "../lib/categories"
import { openingCell } from "../lib/grid"
import { tileSizes } from "../lib/images"
import { breadcrumbSchema, collectionSchema, DESCRIPTIONS } from "../seo"
import Layout from "../layouts/Layout.astro"

export const getStaticPaths = (async () => {
  const projects = (await getCollection("projects")).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  )

  return categories.map((category) => ({
    params: { category: category.slug },
    props: {
      category,
      projects: projects.filter((p) =>
        (p.data.categories as string[]).includes(category.slug),
      ),
    },
  }))
}) satisfies GetStaticPaths

const { category, projects } = Astro.props

/** The first tile of this category's grid, the one photograph above the fold. */
const opening = openingCell(projects, { lead: false })
const openingPhoto = opening && {
  src: opening.item.data.cover,
  sizes: tileSizes(opening.item.data.cover, opening.span, opening.lead),
}

const path = `/${category.slug}`
const description = DESCRIPTIONS.category(category.slug, category.intro)

const schema = [
  collectionSchema({
    name: `${category.label} — ${studio.name}`,
    description,
    path,
    projects: projects.map((project) => ({
      title: project.data.title,
      path: `/projetos/${project.id}`,
    })),
  }),
  breadcrumbSchema([{ name: category.label, path }]),
]
---

<Layout
  openingPhoto={openingPhoto}
  socialPhoto={
    opening && {
      src: opening.item.data.cover,
      alt: opening.item.data.coverAlt,
    }
  }
  schema={schema}
  title={category.label}
  description={description}
>
  {/* The page shows photographs only; the name is here for search engines
      and screen readers, exactly as on the home page. */}
  <h1 class="visually-hidden">
    {category.label} — {studio.name}
  </h1>

  {projects.length > 0 ? (
    <ProjectGrid projects={projects} lead={false} />
  ) : (
    <p class="empty">Estamos preparando esta seção. Volte em breve.</p>
  )}
</Layout>

<style>
  .empty {
    padding-block: var(--space-6) var(--space-7);
    color: var(--color-grey-1);
  }
</style>
