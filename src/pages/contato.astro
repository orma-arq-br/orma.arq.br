---
import { Picture } from "astro:assets"

import photo from "../assets/projects/apartamento-br/01-bedroom.webp"
import { studio, whatsappUrl } from "../config"
import { OPENING_PHOTO, PHOTO, sequenceSizes } from "../lib/images"
import { breadcrumbSchema, DESCRIPTIONS, pageSchema } from "../seo"
import Layout from "../layouts/Layout.astro"

/** The same share of the screen height as a pair of photographs elsewhere. */
const RATIO = 0.764

/** The photograph beside the details, there from the first screen. */
const openingPhoto = { src: photo, sizes: sequenceSizes(photo, RATIO) }

const PHOTO_ALT =
  "Quarto de casal com painel de madeira escura, cabeceira estofada azul e luminária de papel sobre a cama"

const schema = [
  pageSchema({
    type: "ContactPage",
    name: `Contato — ${studio.name}`,
    description: DESCRIPTIONS.contato,
    path: "/contato",
  }),
  breadcrumbSchema([{ name: "Contato", path: "/contato" }]),
]
---

<Layout
  openingPhoto={openingPhoto}
  socialPhoto={{ src: photo, alt: PHOTO_ALT }}
  schema={schema}
  title="Contato"
  description={DESCRIPTIONS.contato}
>
  <h1 class="visually-hidden">Contato — {studio.name}</h1>

  <section class="pair" style={`--ratio: ${RATIO}`}>
    <figure>
      <Picture
        src={photo}
        alt={PHOTO_ALT}
        sizes={openingPhoto.sizes}
        {...PHOTO}
        {...OPENING_PHOTO}
      />
    </figure>

    <div class="details" data-reveal>
      <p class="lead">Vamos conversar?</p>
      <p class="lead">Entre em contato através do WhatsApp ou por e-mail.</p>

      <ul role="list">
        <li>
          <a href={`mailto:${studio.email}`}>{studio.email}</a>
        </li>
        <li>
          <a href={studio.instagram} rel="noopener">
            {studio.instagramHandle}
          </a>
        </li>
        <li>
          <a href={whatsappUrl} rel="noopener">
            chame pelo WhatsApp
          </a>
          <span class="hours"> ({studio.hours.text}) </span>
        </li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  .pair {
    --screen: calc(100svh - var(--header-height) - var(--edge));
    display: flex;
    flex-direction: column;
    gap: var(--edge);
  }

  figure {
    margin: 0;
    overflow: clip;
    background: var(--color-grey-2);
  }

  figure img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .details {
    padding-inline: var(--gutter);
    font-size: var(--text-ui);
    line-height: 1.45;
  }

  .lead {
    font-weight: 700;
  }

  .lead + .lead {
    margin-block-start: 1.35em;
  }

  ul {
    margin: 1.35em 0 0;
    padding: 0;
  }

  .hours {
    color: var(--color-grey-1);
  }

  a {
    position: relative;
  }

  /* The underline draws in on hover, as it does in the menu and the footer. */
  a::after {
    content: "";
    position: absolute;
    inset-block-end: -0.1em;
    inset-inline: 0;
    block-size: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--motion-fast) var(--ease-out-soft);
  }

  a:hover::after,
  a:focus-visible::after {
    transform: scaleX(1);
  }

  @media (min-width: 60rem) {
    .pair {
      flex-direction: row;
      align-items: stretch;
      justify-content: center;
      block-size: var(--screen);
    }

    figure {
      inline-size: calc(var(--screen) * var(--ratio));
    }

    figure img {
      aspect-ratio: auto;
    }

    .details {
      display: flex;
      flex-direction: column;
      justify-content: center;
      inline-size: calc(var(--screen) * var(--ratio));
      padding-inline: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a::after {
      transition: none;
    }
  }
</style>
