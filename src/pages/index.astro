---
import { getCollection } from "astro:content"

import ProjectGrid from "../components/ProjectGrid.astro"
import { studio } from "../config"
import { openingCell } from "../lib/grid"
import { tileSizes } from "../lib/images"
import { collectionSchema, DESCRIPTIONS } from "../seo"
import Layout from "../layouts/Layout.astro"

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)

/** The newest project, alone across the first screen — announced in the head. */
const opening = openingCell(projects)
const openingPhoto = opening && {
  src: opening.item.data.cover,
  sizes: tileSizes(opening.item.data.cover, opening.span, opening.lead),
}

const schema = [
  collectionSchema({
    name: studio.name,
    description: DESCRIPTIONS.home,
    path: "/",
    projects: projects.map((project) => ({
      title: project.data.title,
      path: `/projetos/${project.id}`,
    })),
  }),
]
---

<Layout
  openingPhoto={openingPhoto}
  socialPhoto={
    opening && {
      src: opening.item.data.cover,
      alt: opening.item.data.coverAlt,
    }
  }
  schema={schema}
  description={DESCRIPTIONS.home}
>
  <h1 class="visually-hidden">
    {studio.name} — {studio.tagline}
  </h1>

  <ProjectGrid projects={projects} />
</Layout>
