---
import { Picture } from "astro:assets"
import { getCollection, render } from "astro:content"
import type { GetStaticPaths } from "astro"

import { categoryLabel, type CategorySlug } from "../../lib/categories"
import { breadcrumbSchema, DESCRIPTIONS, projectSchema } from "../../seo"
import {
  LATER_PHOTO,
  openingSizes,
  OPENING_PHOTO,
  PHOTO,
  wholeSizes,
} from "../../lib/images"
import { toScreens } from "../../lib/sequence"
import Layout from "../../layouts/Layout.astro"

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects")

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }))
}) satisfies GetStaticPaths

const { project } = Astro.props
const { Content } = await render(project)
const d = project.data

const facts = [
  {
    label: "Projeto",
    lines: (d.categories as CategorySlug[]).map(categoryLabel),
  },
  { label: "Local", lines: [d.location] },
  ...(d.area ? [{ label: "m²", lines: [String(d.area)] }] : []),
  { label: "Ano", lines: [String(d.year)] },
]

const screens = toScreens(d.images)

/** The photograph the page opens on, announced in the head. */
const openingPhoto = { src: d.cover, sizes: openingSizes(d.cover, 1.06) }

const path = `/projetos/${project.id}`
const description = DESCRIPTIONS.project(d.summary, d.location, d.year)

/** The first category is the one the project is filed under in the trail. */
const primaryCategory = (d.categories as CategorySlug[])[0]

const schema = [
  projectSchema({
    title: d.title,
    summary: d.summary,
    path,
    location: d.location,
    year: d.year,
    area: d.area,
    categories: d.categories as CategorySlug[],
    images: [d.cover, ...d.images.map((image) => image.src)].map(
      (image) => new URL(image.src, Astro.site).href,
    ),
  }),
  breadcrumbSchema([
    { name: categoryLabel(primaryCategory), path: `/${primaryCategory}` },
    { name: d.title, path },
  ]),
]
---

<Layout
  openingPhoto={openingPhoto}
  socialPhoto={{ src: d.cover, alt: d.coverAlt }}
  schema={schema}
  title={d.title}
  description={description}
>
  <article>
    <figure class="opening">
      <Picture
        src={d.cover}
        alt={d.coverAlt}
        sizes={openingPhoto.sizes}
        {...PHOTO}
        {...OPENING_PHOTO}
        transition:name={`cover-${project.id}`}
      />
      <figcaption>
        <h1>{d.title}</h1>
        <dl class="facts">
          {facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              {fact.lines.map((line) => (
                <dd>{line}</dd>
              ))}
            </div>
          ))}
        </dl>
      </figcaption>
    </figure>

    <section class="story">
      <div class="prose" data-reveal>
        <Content />
      </div>
    </section>

    {screens.map(({ photos, sum }) => (
      <div
        class="screen"
        style={`--sum: ${sum.toFixed(4)}; --count: ${photos.length}`}
      >
        {photos.map(({ item }) => (
          <figure
            style={`--ratio: ${item.src.width} / ${item.src.height}`}
            data-reveal="clip"
          >
            <Picture
              src={item.src}
              alt={item.alt}
              sizes={wholeSizes(item.src, sum)}
              {...PHOTO}
              {...LATER_PHOTO}
            />
          </figure>
        ))}
      </div>
    ))}
  </article>
</Layout>

<style>
  /* Every screen of this page is one grid row tall, so the page moves a
     photograph at a time, exactly like the home page. */
  article {
    container-type: inline-size;
    --screen: calc(100svh - var(--header-height) - var(--edge));
    display: flex;
    flex-direction: column;
    gap: var(--edge);
  }

  /* ------------------------------------------------------------- opening */
  .opening {
    position: relative;
    margin: 0;
    overflow: clip;
    background: var(--color-grey-2);
  }

  .opening img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    animation: settle 12s var(--ease-out-soft) forwards;
  }

  @keyframes settle {
    from {
      transform: scale(1.06);
    }
    to {
      transform: scale(1);
    }
  }

  .opening figcaption {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-7) clamp(1rem, 2.7vw, 3.25rem) var(--edge);
    color: #fff;
    /* Just enough shading to hold the words over a pale photograph. */
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.5);
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 0.35) 0%,
      rgb(0 0 0 / 0) 100%
    );
  }

  h1 {
    font-size: clamp(1.5rem, 1.875vw, 2.25rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) clamp(1rem, 2.6vw, 3.125rem);
    margin: 0;
    font-size: var(--text-ui);
    line-height: 1.35;
  }

  dt {
    font-weight: 700;
  }

  dd {
    margin: 0;
  }

  /* --------------------------------------------------------------- story */
  .story {
    display: grid;
    place-items: center;
    padding-inline: var(--gutter);
  }

  .prose {
    max-inline-size: var(--measure);
    font-size: var(--text-ui);
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* The base layer caps paragraph width; the column is the measure here. */
  .prose :global(p) {
    max-inline-size: none;
  }

  .prose :global(p + p) {
    margin-block-start: 1.6em;
  }

  /* ----------------------------------------------------------- sequence */
  .screen {
    display: flex;
    flex-direction: column;
    gap: var(--edge);
  }

  /* Nothing is ever written over these photographs. There
     is no caption here and no field to put one in — only the opening
     photograph at the top of the page carries words.

     Nor is anything cropped: each box has its own photograph's proportions,
     so a 16:9 stays 16:9 and a 9:16 stays 9:16. */
  .screen figure {
    margin: 0;
    overflow: clip;
    aspect-ratio: var(--ratio);
    background: var(--color-grey-2);
  }

  .screen img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* On the phone everything is simply full width, one under the other. */
  .opening {
    block-size: auto;
  }

  .opening img {
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 60rem) {
    .opening {
      block-size: var(--screen);
    }

    /* A row is a grid row tall, unless its photographs side by side would
       run wider than the column; then the whole row shrinks to fit. */
    .screen {
      block-size: min(
        var(--screen),
        (100cqi - (var(--count) - 1) * var(--edge)) / var(--sum)
      );
    }

    /* A screenful when the text fits, taller when it does not, so a long
       description never slides up under the menu band. */
    .story {
      min-block-size: var(--screen);
      padding-block: var(--edge);
    }

    .opening img {
      aspect-ratio: auto;
    }

    .screen {
      flex-direction: row;
      align-items: stretch;
      justify-content: center;
    }

    .screen figure {
      flex: none;
      block-size: 100%;
    }

    /* Justified only once the column is wide enough not to gap badly. */
    .prose {
      text-align: justify;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .opening img {
      animation: none;
    }
  }
</style>
