---
import { Picture } from "astro:assets"

import opening from "../assets/projects/apartamento-br/02-closet-window.webp"
import { partnerNames, studio } from "../config"
import { openingSizes, OPENING_PHOTO, PHOTO } from "../lib/images"
import { breadcrumbSchema, DESCRIPTIONS, pageSchema } from "../seo"
import Layout from "../layouts/Layout.astro"

/** The three words across the top of the page. */
const promise = ["Forma", "Reforma", "Transforma"]

const OPENING_ALT =
  "Corredor com armários de madeira escura do piso ao teto e luminária de chão redonda"

const schema = [
  pageSchema({
    type: "AboutPage",
    name: `Sobre nós — ${studio.name}`,
    description: DESCRIPTIONS.sobre,
    path: "/sobre",
  }),
  breadcrumbSchema([{ name: "Sobre nós", path: "/sobre" }]),
]
---

<Layout
  socialPhoto={{ src: opening, alt: OPENING_ALT }}
  schema={schema}
  title="Sobre nós"
  description={DESCRIPTIONS.sobre}
>
  <h1 class="visually-hidden">Sobre nós — {studio.name}</h1>

  <section class="story">
    <div class="column">
      <p class="promise" data-reveal>
        {promise.map((word) => (
          <span>{word}</span>
        ))}
      </p>

      <p class="prose" data-reveal style="--stagger: 1">
        Nossa história começou há dez anos, no primeiro dia de faculdade. A cada
        trabalho em grupo a amizade foi ficando mais forte, e hoje ela vai muito
        além do profissional. Somos <strong>{partnerNames[0]}</strong> e{" "}
        <strong>{partnerNames[1]}</strong>, duas arquitetas formadas pela UFRGS,
        com uma obsessão por detalhe e um fascínio por espaços funcionais e
        belos, principalmente quando se trata de criar o lugar dos sonhos de
        cada cliente: onde se vai morar e criar memórias. O escritório nasceu da
        vontade de atuarmos juntas em projetos em que acreditamos, com o
        propósito de proporcionar conforto, segurança, harmonia e paz, tanto no
        que se vê quanto no que se sente.
      </p>
    </div>
  </section>

  {/* On a wide screen the words fill the first screen and this sits below
      them; on a phone three quarters of it is already showing. So it is never
      deferred — but it isn't announced in the head either, because on the
      screens where it is invisible that would be a large photograph fetched
      ahead of the words a visitor came to read. */}
  <figure class="portrait">
    <Picture
      src={opening}
      alt={OPENING_ALT}
      sizes={openingSizes(opening)}
      {...PHOTO}
      {...OPENING_PHOTO}
    />
  </figure>
</Layout>

<style>
  /* Two screens: the words and the story, then one photograph. */
  .story,
  .portrait {
    --screen: calc(100svh - var(--header-height) - var(--edge));
  }

  .story {
    display: grid;
    place-items: center;
    padding: var(--space-6) var(--gutter);
  }

  .column {
    inline-size: 100%;
    max-inline-size: var(--measure);
  }

  .promise {
    /* The base layer caps paragraph width for readability; these two fill the
       column they sit in, which is already the right measure. */
    max-inline-size: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3) var(--space-4);
    margin-block-end: var(--space-5);
    font-size: var(--text-ui);
  }

  .prose {
    max-inline-size: none;
    font-size: var(--text-ui);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .prose strong {
    font-weight: 700;
  }

  .portrait {
    margin: var(--edge) 0 0;
    overflow: clip;
    background: var(--color-grey-2);
  }

  .portrait img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 60rem) {
    .portrait {
      block-size: var(--screen);
    }

    /* A screenful when the text fits, taller when it does not, so a long
       story never slides up under the menu band. */
    .story {
      min-block-size: var(--screen);
      padding-block: var(--edge);
    }

    .portrait img {
      aspect-ratio: auto;
    }

    .prose {
      text-align: justify;
    }
  }
</style>
